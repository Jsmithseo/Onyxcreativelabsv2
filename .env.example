# Contractor authentication — keep actual values in .env.local locally and
# Vercel Secret variables for Preview and Production. Never commit them.
BDR_APP_URL=https://onyxcreativelabs.com
BDR_MAGIC_LINK_SECRET=
# Gmail accounts only for now. Add a Google Workspace domain here later.
BDR_ALLOWED_EMAIL_DOMAINS=gmail.com
BDR_ALLOWED_CONTRACTOR_EMAILS=

# Gmail API configuration. Create a Google OAuth web client, enable the Gmail
# API, grant only gmail.send, then store these as server-only secrets.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=
BDR_EMAIL_FROM=
