# Contractor authentication — keep actual values in .env.local locally and
# Vercel Secret variables for Preview and Production. Never commit them.
BDR_APP_URL=https://onyxcreativelabs.com
BDR_MAGIC_LINK_SECRET=
# Gmail accounts only for now. Add a Google Workspace domain here later.
BDR_ALLOWED_EMAIL_DOMAINS=gmail.com
BDR_ALLOWED_CONTRACTOR_EMAILS=
# Admins are a separate allowlist; contractor links never grant admin access.
BDR_ALLOWED_ADMIN_EMAILS=

# Shared campaign, lead, activity, and deal records. Use a separate Neon
# branch/database for local and preview validation; never point this at the
# production database.
DATABASE_URL=

# Contractor records are stored privately in Vercel Blob. Use a separate,
# non-production Blob store/token for local and preview validation.
BLOB_READ_WRITE_TOKEN=

# Gmail API configuration. Create a Google OAuth web client, enable the Gmail
# API, grant only gmail.send, then store these as server-only secrets.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=
BDR_EMAIL_FROM=

# Optional Twilio integration. Use a dedicated Twilio account or subaccount.
# Run npm run db:migrate:twilio against the intended operations database.
# HTTPS origin must match the public Twilio webhook URLs exactly.
# Set the TwiML App Voice Request URL to POST /api/operations/twilio/voice.
# Use a Messaging Service with opt-out handling and an approved sender for SMS.
TWILIO_WEBHOOK_ORIGIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_VOICE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Optional. Use the registered brand name if it differs from Onyx Creative Labs.
TWILIO_SMS_SENDER_NAME=
